# Target Scenarios for Snapshots & Testbeds (Replace with your own scenario short IDs)
AID_SCENARIO_ENTITY_CARDS=your_ec_scenario_id
AID_SCENARIO_INNER_ENTITY=your_ie_scenario_id
AID_SCENARIO_MODULES=your_modules_scenario_id
AID_SCENARIO_GETOPT=your_getopt_scenario_id
AID_SCENARIO_TEST_HOST=your_host_scenario_id
